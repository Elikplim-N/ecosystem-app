{
  "name": "ecosystem-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ecosystem recycling platform API - Postgres, no Firebase",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
