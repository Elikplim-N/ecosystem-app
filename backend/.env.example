# ============================================================
# Ecosystem API - local configuration
#
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# ============================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---------------------------------------------------
# Postgres 13 is on port 5433 on this machine; Postgres 18 is on 5432.
# The `ecosystem` database was created on the 13 cluster.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/ecosystem
DB_POOL_MAX=10
# Must be true in production.
DB_SSL=false

# --- Auth -------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotating this signs out every user.
JWT_SECRET=replace_me_with_64_hex_characters
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id cost. Higher = slower to hash and slower to attack, but login
# gets slower. These are OWASP's recommended values for argon2id.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- CORS -------------------------------------------------------
# Exact origins allowed. Comma separated. Leave empty in development only.
# The Flutter web app runs on http://localhost:8765.
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
