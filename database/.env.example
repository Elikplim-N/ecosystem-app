# ============================================================
# Ecosystem backend — local development configuration
#
# Copy to .env and fill in the real password. NEVER commit .env.
# ============================================================

# --- Database ---------------------------------------------------
# Postgres 18 is on 5433, Postgres 13 is on 5432 on this machine.
# Use whichever cluster you created the `ecosystem` database in.
# The password is the superuser password set during Postgres install.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/ecosystem

# For scripts that read discrete parts instead of a URL:
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecosystem
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Pool size. Keep it small on a small VPS; Postgres is happier with
# many small pools than a few very large ones.
DB_POOL_MAX=10

# --- Auth --------------------------------------------------------
# Generate with:  openssl rand -hex 32   (or any 32-byte hex string)
# Used to sign access tokens. Rotating it invalidates every access token.
JWT_SECRET=replace_me_with_64_hex_characters

# Minutes. Keep short; refresh tokens are the long-lived credential.
ACCESS_TOKEN_TTL_MIN=15
# Days.
REFRESH_TOKEN_TTL_DAYS=30

# --- Service -----------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated allowed origins for CORS. Your Flutter web build will
# need the exact origin, not '*', because credentials are used.
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# --- Mail (needed for password reset, later) --------------------
# Left blank until an email provider is chosen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@ecosystem.local

# --- Device ingestion -------------------------------------------
# Undecided. The schema already has bins.sensor_id and
# bin_status_events, so whichever transport you pick will not need
# a schema migration.
DEVICE_AUTH_MODE=bearer
